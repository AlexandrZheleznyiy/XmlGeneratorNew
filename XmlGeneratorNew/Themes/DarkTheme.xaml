<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- ЦВЕТОВАЯ ПАЛИТРА MODERN DARK IDE (VS Code / JetBrains Style)     -->
    <!-- ================================================================= -->

    <!-- Фоны -->
    <SolidColorBrush x:Key="IdeBgMain" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="IdeBgSidebar" Color="#252526"/>
    <SolidColorBrush x:Key="IdeBgCard" Color="#252526"/>
    <SolidColorBrush x:Key="IdeBgCardInner" Color="#2D2D30"/>
    <SolidColorBrush x:Key="IdeBgInput" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="IdeBgHover" Color="#2A2D2E"/>
    <SolidColorBrush x:Key="IdeBgActive" Color="#37373D"/>
    <SolidColorBrush x:Key="IdeBgSelected" Color="#094771"/>
    <SolidColorBrush x:Key="IdeBgHeader" Color="#2D2D30"/>
    <SolidColorBrush x:Key="IdeBgStatusBar" Color="#007ACC"/>

    <!-- Границы -->
    <SolidColorBrush x:Key="IdeBorder" Color="#3E3E42"/>
    <SolidColorBrush x:Key="IdeBorderLight" Color="#505054"/>
    <SolidColorBrush x:Key="IdeBorderFocus" Color="#007ACC"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="IdeTextPrimary" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="IdeTextTitle" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="IdeTextMuted" Color="#858585"/>
    <SolidColorBrush x:Key="IdeTextDim" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="IdeTextHighlight" Color="#4EC9B0"/>

    <!-- Акценты -->
    <SolidColorBrush x:Key="IdeAccentBlue" Color="#007ACC"/>
    <SolidColorBrush x:Key="IdeAccentBlueHover" Color="#1C97EA"/>
    <SolidColorBrush x:Key="IdeAccentBluePressed" Color="#094771"/>
    <SolidColorBrush x:Key="IdeSuccess" Color="#4EC9B0"/>
    <SolidColorBrush x:Key="IdeWarning" Color="#CCA700"/>
    <SolidColorBrush x:Key="IdeDanger" Color="#F14C4C"/>
    <SolidColorBrush x:Key="IdeDangerHover" Color="#E51400"/>

    <!-- Цвета бейджей структуры (Синтаксическая подсветка Dark IDE) -->
    <!-- Секция -->
    <SolidColorBrush x:Key="BadgeSectionBg" Color="#162D4A"/>
    <SolidColorBrush x:Key="BadgeSectionFg" Color="#58A6FF"/>
    <SolidColorBrush x:Key="BadgeSectionBorder" Color="#1F6FEB"/>
    <!-- Группа -->
    <SolidColorBrush x:Key="BadgeGroupBg" Color="#103B38"/>
    <SolidColorBrush x:Key="BadgeGroupFg" Color="#39C5CF"/>
    <SolidColorBrush x:Key="BadgeGroupBorder" Color="#0D9488"/>
    <!-- Один из (OneOf) -->
    <SolidColorBrush x:Key="BadgeOneOfBg" Color="#123B22"/>
    <SolidColorBrush x:Key="BadgeOneOfFg" Color="#4ADE80"/>
    <SolidColorBrush x:Key="BadgeOneOfBorder" Color="#16A34A"/>
    <!-- Таблица -->
    <SolidColorBrush x:Key="BadgeTableBg" Color="#4A2B0E"/>
    <SolidColorBrush x:Key="BadgeTableFg" Color="#FB923C"/>
    <SolidColorBrush x:Key="BadgeTableBorder" Color="#D97706"/>
    <!-- Строка -->
    <SolidColorBrush x:Key="BadgeRowBg" Color="#4E270A"/>
    <SolidColorBrush x:Key="BadgeRowFg" Color="#FBBF24"/>
    <SolidColorBrush x:Key="BadgeRowBorder" Color="#B45309"/>
    <!-- Ячейка -->
    <SolidColorBrush x:Key="BadgeCellBg" Color="#2A2F3A"/>
    <SolidColorBrush x:Key="BadgeCellFg" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="BadgeCellBorder" Color="#4B5563"/>
    <!-- Свойство -->
    <SolidColorBrush x:Key="BadgePropertyBg" Color="#361563"/>
    <SolidColorBrush x:Key="BadgePropertyFg" Color="#C084FC"/>
    <SolidColorBrush x:Key="BadgePropertyBorder" Color="#7C3AED"/>

    <!-- ================================================================= -->
    <!-- БАЗОВЫЕ СТИЛИ КОНТРОЛОВ ДЛЯ ВСЕХ ОКОН ПРИЛОЖЕНИЯ                  -->
    <!-- ================================================================= -->

    <!-- Стиль по умолчанию для Window -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource IdeBgMain}"/>
        <Setter Property="Foreground" Value="{StaticResource IdeTextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Consolas, -apple-system, sans-serif"/>
    </Style>

    <!-- Стиль по умолчанию для TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource IdeTextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Стиль по умолчанию для TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource IdeBgInput}"/>
        <Setter Property="Foreground" Value="{StaticResource IdeTextPrimary}"/>
        <Setter Property="CaretBrush" Value="#FFFFFF"/>
        <Setter Property="SelectionBrush" Value="#264F78"/>
        <Setter Property="BorderBrush" Value="{StaticResource IdeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource IdeBorderLight}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="true">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource IdeBorderFocus}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль по умолчанию для CheckBox -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource IdeTextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CheckBorder"
                                Grid.Column="0"
                                Width="18" Height="18"
                                Background="{StaticResource IdeBgInput}"
                                BorderBrush="{StaticResource IdeBorder}"
                                BorderThickness="1.5"
                                CornerRadius="3"
                                VerticalAlignment="Center">
                            <Path x:Name="CheckGlyph"
                                  Data="M 3,9 L 7,13 L 15,4"
                                  Stroke="{StaticResource IdeAccentBlueHover}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="CheckBorder" Property="Background" Value="#102A45"/>
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource IdeAccentBlue}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource IdeBorderFocus}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль базовой кнопки (Dark Secondary) -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource IdeBgCardInner}"/>
        <Setter Property="Foreground" Value="{StaticResource IdeTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource IdeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource IdeBgHover}"/>
                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource IdeBorderLight}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource IdeBgActive}"/>
                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource IdeBorderFocus}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль акцентной кнопки (Primary Blue Button) -->
    <Style x:Key="PrimaryDarkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#0E639C"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource IdeAccentBlue}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource IdeAccentBlueHover}"/>
                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="#388BFD"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource IdeAccentBluePressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль опасной кнопки (Danger Button) -->
    <Style x:Key="DangerDarkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#3A1D1D"/>
        <Setter Property="Foreground" Value="{StaticResource IdeDanger}"/>
        <Setter Property="BorderBrush" Value="#5A2D2D"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#502424"/>
                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource IdeDanger}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#251010"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для GroupBox -->
    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{StaticResource IdeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource IdeBgCard}"/>
        <Setter Property="Foreground" Value="{StaticResource IdeTextTitle}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="12,10">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource IdeBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextBlock.FontWeight="Bold"
                                                  TextBlock.FontSize="13.5"
                                                  TextBlock.Foreground="{StaticResource IdeTextTitle}"/>
                            </Border>
                            <ContentPresenter/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стили для TabControl & TabItem (Modern Dark IDE Segmented Tabs) -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,12,0,0"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Background" Value="{StaticResource IdeBgCard}"/>
        <Setter Property="Foreground" Value="{StaticResource IdeTextMuted}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="tabBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Margin="0,0,4,0"
                            CornerRadius="4,4,0,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ContentSource="Header" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource IdeBgMain}"/>
                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource IdeAccentBlue}"/>
                            <Setter Property="Foreground" Value="{StaticResource IdeTextTitle}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource IdeBgHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource IdeTextPrimary}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
