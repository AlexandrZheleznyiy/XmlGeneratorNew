<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- ЦВЕТОВАЯ ПАЛИТРА FLUENT STUDIO (Windows 11 / WinUI 3 Style)       -->
    <!-- ================================================================= -->

    <!-- Фоны -->
    <SolidColorBrush x:Key="FluentBgWindow" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="FluentBgCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FluentBgSubCard" Color="#F8F9FA"/>
    <SolidColorBrush x:Key="FluentBgInput" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FluentBgHover" Color="#F0F0F2"/>
    <SolidColorBrush x:Key="FluentBgActive" Color="#E5E5E8"/>
    <SolidColorBrush x:Key="FluentBgSelected" Color="#E5F1FB"/>
    <SolidColorBrush x:Key="FluentBgHeader" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FluentBgStatusBar" Color="#F8F9FA"/>

    <!-- Границы -->
    <SolidColorBrush x:Key="FluentBorder" Color="#E2E2E6"/>
    <SolidColorBrush x:Key="FluentBorderLight" Color="#EBEBEF"/>
    <SolidColorBrush x:Key="FluentBorderFocus" Color="#005FB8"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="FluentTextPrimary" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="FluentTextTitle" Color="#0F0F10"/>
    <SolidColorBrush x:Key="FluentTextSecondary" Color="#5A5A60"/>
    <SolidColorBrush x:Key="FluentTextMuted" Color="#8A8A90"/>

    <!-- Акценты Windows 11 -->
    <SolidColorBrush x:Key="FluentAccent" Color="#005FB8"/>
    <SolidColorBrush x:Key="FluentAccentHover" Color="#1975C5"/>
    <SolidColorBrush x:Key="FluentAccentPressed" Color="#004F96"/>
    <SolidColorBrush x:Key="FluentAccentLight" Color="#EBF3FB"/>

    <SolidColorBrush x:Key="FluentSuccess" Color="#0F7B36"/>
    <SolidColorBrush x:Key="FluentWarning" Color="#996500"/>
    <SolidColorBrush x:Key="FluentDanger" Color="#C42B1C"/>
    <SolidColorBrush x:Key="FluentDangerHover" Color="#B32417"/>
    <SolidColorBrush x:Key="FluentDangerBg" Color="#FDF2F2"/>

    <!-- Цвета маркеров структуры (Fluent Light) -->
    <!-- Секция -->
    <SolidColorBrush x:Key="FluentBadgeSectionBg" Color="#E0EEFF"/>
    <SolidColorBrush x:Key="FluentBadgeSectionFg" Color="#005FB8"/>
    <SolidColorBrush x:Key="FluentBadgeSectionBorder" Color="#CCE4FC"/>
    <!-- Группа -->
    <SolidColorBrush x:Key="FluentBadgeGroupBg" Color="#E0F2FE"/>
    <SolidColorBrush x:Key="FluentBadgeGroupFg" Color="#0369A1"/>
    <SolidColorBrush x:Key="FluentBadgeGroupBorder" Color="#BAE6FD"/>
    <!-- Один из (OneOf) -->
    <SolidColorBrush x:Key="FluentBadgeOneOfBg" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="FluentBadgeOneOfFg" Color="#15803D"/>
    <SolidColorBrush x:Key="FluentBadgeOneOfBorder" Color="#BBF7D0"/>
    <!-- Таблица -->
    <SolidColorBrush x:Key="FluentBadgeTableBg" Color="#FFEDD5"/>
    <SolidColorBrush x:Key="FluentBadgeTableFg" Color="#C2410C"/>
    <SolidColorBrush x:Key="FluentBadgeTableBorder" Color="#FED7AA"/>
    <!-- Строка -->
    <SolidColorBrush x:Key="FluentBadgeRowBg" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="FluentBadgeRowFg" Color="#B45309"/>
    <SolidColorBrush x:Key="FluentBadgeRowBorder" Color="#FDE68A"/>
    <!-- Ячейка -->
    <SolidColorBrush x:Key="FluentBadgeCellBg" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="FluentBadgeCellFg" Color="#4B5563"/>
    <SolidColorBrush x:Key="FluentBadgeCellBorder" Color="#E5E7EB"/>
    <!-- Свойство -->
    <SolidColorBrush x:Key="FluentBadgePropertyBg" Color="#F3E8FF"/>
    <SolidColorBrush x:Key="FluentBadgePropertyFg" Color="#7E22CE"/>
    <SolidColorBrush x:Key="FluentBadgePropertyBorder" Color="#E9D5FF"/>

    <!-- ================================================================= -->
    <!-- БАЗОВЫЕ СТИЛИ КОНТРОЛОВ FLUENT                                    -->
    <!-- ================================================================= -->

    <!-- Window -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource FluentBgWindow}"/>
        <Setter Property="Foreground" Value="{StaticResource FluentTextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, -apple-system, sans-serif"/>
    </Style>

    <!-- TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FluentTextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- TextBox с акцентной нижней границей WinUI 3 -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource FluentBgInput}"/>
        <Setter Property="Foreground" Value="{StaticResource FluentTextPrimary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource FluentAccent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource FluentAccentLight}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FluentBorder}"/>
        <Setter Property="BorderThickness" Value="1,1,1,1"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="border" Property="BorderBrush" Value="#B0B0B5"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="true">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource FluentAccent}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1,1,1,2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="border" Property="Background" Value="#F8F8F8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль переключателя ToggleSwitch / CheckBox в стиле Windows 11 -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource FluentTextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Капсула переключателя (Pill) -->
                        <Border x:Name="SwitchTrack"
                                Grid.Column="0"
                                Width="38" Height="20"
                                Background="#E8E8EC"
                                BorderBrush="{StaticResource FluentBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                VerticalAlignment="Center">
                            <Grid>
                                <!-- Бегунок (Thumb) -->
                                <Border x:Name="SwitchThumb"
                                        Width="14" Height="14"
                                        Background="#5A5A60"
                                        CornerRadius="7"
                                        HorizontalAlignment="Left"
                                        Margin="2,0,0,0"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ContentPresenter Grid.Column="1"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource FluentAccent}"/>
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource FluentAccent}"/>
                            <Setter TargetName="SwitchThumb" Property="Background" Value="#FFFFFF"/>
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,2,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource FluentAccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Базовая кнопка WinUI 3 (Fluent Standard) -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource FluentBgCard}"/>
        <Setter Property="Foreground" Value="{StaticResource FluentTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FluentBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource FluentBgHover}"/>
                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="#C5C5CB"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource FluentBgActive}"/>
                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource FluentAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Акцентная кнопка WinUI 3 (Fluent Primary Blue) -->
    <Style x:Key="FluentPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource FluentAccent}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource FluentAccent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource FluentAccentHover}"/>
                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource FluentAccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource FluentAccentPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопка опасного действия (Danger) -->
    <Style x:Key="FluentDangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource FluentDangerBg}"/>
        <Setter Property="Foreground" Value="{StaticResource FluentDanger}"/>
        <Setter Property="BorderBrush" Value="#F8D7DA"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#FCE8E8"/>
                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource FluentDanger}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#F8D7DA"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль Expander (Windows 11 Accordion Card) -->
    <Style TargetType="Expander">
        <Setter Property="Background" Value="{StaticResource FluentBgCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FluentBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Шапка Expander -->
                            <ToggleButton x:Name="HeaderSite"
                                          Grid.Row="0"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Cursor="Hand">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="HeaderBorder"
                                                            Background="{StaticResource FluentBgSubCard}"
                                                            CornerRadius="7,7,0,0"
                                                            Padding="14,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ContentPresenter Grid.Column="0"
                                                                              Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                              VerticalAlignment="Center"
                                                                              TextBlock.FontWeight="SemiBold"
                                                                              TextBlock.FontSize="13.5"
                                                                              TextBlock.Foreground="{StaticResource FluentTextTitle}"/>
                                                            <TextBlock x:Name="Chevron"
                                                                       Grid.Column="1"
                                                                       Text="⌵"
                                                                       FontFamily="Segoe UI, Consolas"
                                                                       FontSize="14"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource FluentTextSecondary}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="10,0,4,0"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource FluentBgHover}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Chevron" Property="Text" Value="⌃"/>
                                                            <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource FluentAccent}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <!-- Содержимое карточки -->
                            <Border x:Name="ContentSite"
                                    Grid.Row="1"
                                    Visibility="Collapsed"
                                    Padding="14,12"
                                    BorderBrush="{StaticResource FluentBorderLight}"
                                    BorderThickness="0,1,0,0"
                                    Background="{StaticResource FluentBgCard}">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="HeaderSite" Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBorder"
                                                Background="{StaticResource FluentBgSubCard}"
                                                CornerRadius="7"
                                                Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                  VerticalAlignment="Center"
                                                                  TextBlock.FontWeight="SemiBold"
                                                                  TextBlock.FontSize="13.5"
                                                                  TextBlock.Foreground="{StaticResource FluentTextTitle}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="⌵"
                                                           FontFamily="Segoe UI, Consolas"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource FluentTextSecondary}"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0,4,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource FluentBgHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GroupBox WinUI 3 Card -->
    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{StaticResource FluentBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource FluentBgCard}"/>
        <Setter Property="Foreground" Value="{StaticResource FluentTextTitle}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="14,12">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource FluentBorderLight}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,10">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextBlock.FontWeight="Bold"
                                                  TextBlock.FontSize="13.5"
                                                  TextBlock.Foreground="{StaticResource FluentTextTitle}"/>
                            </Border>
                            <ContentPresenter/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
