<Window x:Class="XmlGeneratorNew.Views.NamespaceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка пространств имен"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanResizeWithGrip"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource FluentBgWindow}"
        Foreground="{StaticResource FluentTextPrimary}"
        SnapsToDevicePixels="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка окна в стиле Windows 11 Fluent -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="{StaticResource FluentBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource FluentAccentLight}" BorderBrush="{StaticResource FluentBorderLight}" BorderThickness="1" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                    <TextBlock Text="⚙" FontSize="18" Foreground="{StaticResource FluentAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Пространства имен" FontWeight="Bold" FontSize="16" Foreground="{StaticResource FluentTextTitle}"/>
                    <TextBlock Text="Управление атрибутами xmlns корневого узла XML" FontSize="12" Foreground="{StaticResource FluentTextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Имя шаблона (Карточка WinUI 3) -->
        <Border Grid.Row="1" Background="{StaticResource FluentBgCard}" BorderBrush="{StaticResource FluentBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Имя шаблона" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource FluentTextTitle}"/>
                    <Border Background="{StaticResource FluentBadgeSectionBg}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                        <TextBlock Text="consultation name" FontSize="11" Foreground="{StaticResource FluentBadgeSectionFg}" FontFamily="Consolas, Segoe UI"/>
                    </Border>
                </StackPanel>
                <TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="9,6"/>
            </StackPanel>
        </Border>

        <!-- Список пространств имен (Toggle-переключатели) -->
        <Border Grid.Row="2" Background="{StaticResource FluentBgCard}" BorderBrush="{StaticResource FluentBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Активные пространства имен" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource FluentTextTitle}" Margin="0,0,0,10"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="NamespacesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource FluentBgSubCard}" BorderBrush="{StaticResource FluentBorderLight}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                    <CheckBox Content="{Binding DisplayName}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              FontFamily="Consolas, Segoe UI"
                                              FontSize="12.5"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Готово" Width="95" Height="32" Margin="0,0,10,0" IsDefault="True" Style="{StaticResource FluentPrimaryButton}" Click="Ok_Click"/>
            <Button Content="Отмена" Width="90" Height="32" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>