<Window x:Class="XmlGeneratorNew.Views.TypeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тип шаблона"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource FluentBgWindow}"
        Foreground="{StaticResource FluentTextPrimary}"
        SnapsToDevicePixels="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка окна WinUI 3 -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="{StaticResource FluentBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource FluentAccentLight}" BorderBrush="{StaticResource FluentBorderLight}" BorderThickness="1" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                    <TextBlock Text="📄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Тип шаблона" FontWeight="Bold" FontSize="16" Foreground="{StaticResource FluentTextTitle}"/>
                    <TextBlock Text="Выберите категорию медицинского протокола" FontSize="12" Foreground="{StaticResource FluentTextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Карточка вариантов -->
        <Border Grid.Row="1" Background="{StaticResource FluentBgCard}" BorderBrush="{StaticResource FluentBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Категория документа" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource FluentTextTitle}" Margin="0,0,0,10"/>

                <Border Background="{StaticResource FluentBgSubCard}" BorderBrush="{StaticResource FluentBorderLight}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                    <CheckBox Content="Консультация (Врачебный прием)"
                              IsChecked="{Binding IsConsultation, Mode=TwoWay}"
                              FontWeight="Medium"
                              FontSize="13"/>
                </Border>

                <Border Background="{StaticResource FluentBgSubCard}" BorderBrush="{StaticResource FluentBorderLight}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                    <CheckBox Content="Инструментальное исследование (УЗИ, Рентген, ЭКГ)"
                              IsChecked="{Binding IsInstrumental, Mode=TwoWay}"
                              FontWeight="Medium"
                              FontSize="13"/>
                </Border>

                <Border Background="{StaticResource FluentBgSubCard}" BorderBrush="{StaticResource FluentBorderLight}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <CheckBox Content="Лабораторное исследование (Анализы)"
                              IsChecked="{Binding IsLaboratory, Mode=TwoWay}"
                              FontWeight="Medium"
                              FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Готово" Width="95" Height="32" Margin="0,0,10,0" IsDefault="True" Style="{StaticResource FluentPrimaryButton}" Click="Ok_Click"/>
            <Button Content="Отмена" Width="90" Height="32" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>