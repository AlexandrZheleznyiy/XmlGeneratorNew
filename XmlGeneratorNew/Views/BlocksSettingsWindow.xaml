<Window x:Class="XmlGeneratorNew.Views.BlocksSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки блоков" 
        Height="450" 
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Выберите блоки для включения в документ:"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <GroupBox Header="Диагнозы" Margin="0,0,0,10">
                <StackPanel Margin="5">
                    <CheckBox Content="Диагнозы МКБ" 
                              IsChecked="{Binding IsDiagnosis}"
                              Margin="0,5"/>
                    <CheckBox Content="Диагнозы МКФ - первичный" 
                              IsChecked="{Binding IsIcfInitial}"
                              Margin="0,5"/>
                    <CheckBox Content="Диагнозы МКФ - повторный" 
                              IsChecked="{Binding IsIcfRecurrent}"
                              Margin="0,5"/>
                    <CheckBox Content="Диагнозы МКФ - заключительный" 
                              IsChecked="{Binding IsIcfFinal}"
                              Margin="0,5"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Лечение" Margin="0,0,0,10">
                <StackPanel Margin="5">
                    <CheckBox Content="Назначения" 
                              IsChecked="{Binding IsAssignments}"
                              Margin="0,5"/>
                    <CheckBox Content="Лечебные действия" 
                              IsChecked="{Binding IsTreatmentActions}"
                              Margin="0,5"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Документы">
                <StackPanel Margin="5">
                    <CheckBox Content="Вложения" 
                              IsChecked="{Binding IsAttachments}"
                              Margin="0,5"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center">
            <Button Content="OK" 
                    Width="80" 
                    Height="30"
                    IsDefault="True"
                    Click="Ok_Click"
                    Margin="0,0,10,0"/>
            <Button Content="Отмена" 
                    Width="80" 
                    Height="30"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
